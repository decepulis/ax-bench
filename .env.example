# Long-lived OAuth token generated by `claude setup-token` on the host.
# Billed against your Claude.ai subscription. Treat as a secret; do not commit.
CLAUDE_CODE_OAUTH_TOKEN=

# Model to use for the agent under test. Opus 4.7 1M-context.
AX_BENCH_MODEL=claude-opus-4-7[1m]

# Model to use for judges + summarizer.
AX_BENCH_JUDGE_MODEL=claude-opus-4-7[1m]
